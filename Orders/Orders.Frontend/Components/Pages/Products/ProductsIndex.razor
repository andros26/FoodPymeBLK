@page "/products"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Products"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between align-center">
                <MudText Typo="Typo.h6" Class="me-4">Productos</MudText>
                <MudButton Variant="Variant.Outlined"
                           EndIcon="@Icons.Material.Filled.Add"
                           Color="Color.Info"
                           href="/products/create">
                    Nuevo
                </MudButton>
            </div>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Descripción</MudTh>
            <MudTh>Precio</MudTh>
            <MudTh>Inventario</MudTh>
            <MudTh Style="text-align:center">Categorías</MudTh>
            <MudTh Style="text-align:center">Imágenes</MudTh>
            <MudTh>Imagen Principal</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Name</MudTd>
            <MudTd DataLabel="Descripción">@context.Description</MudTd>
            <MudTd DataLabel="Precio">@($"{context.Price:C2}")</MudTd>
            <MudTd DataLabel="Inventario">@($"{context.Stock:N2}")</MudTd>
            <MudTd DataLabel="Categorías" Style="text-align:center">
                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.ProductCategoriesNumber</MudChip>
            </MudTd>
            <MudTd DataLabel="Imágenes" Style="text-align:center">
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@context.ProductImagesNumber</MudChip>
            </MudTd>
            <MudTd DataLabel="Imagen Principal">
                <MudImage Src="@context.MainImage"
                          Width="64"
                          Height="64"
                          Alt="@context.Name"
                          Elevation="5"
                          Class="rounded-lg shadow-sm"
                          ObjectFit="ObjectFit.Cover" />
            </MudTd>
            <MudTd>
                <MudTooltip Text="Editar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               href="@($"/products/edit/{context.Id}")"
                               Class="me-2">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="Borrar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="@(() => DeleteAsync(context))">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-4">
                No se encontraron productos.
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}